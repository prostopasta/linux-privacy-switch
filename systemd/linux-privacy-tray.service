[Unit]
Description=Privacy Switch Tray Indicator
Documentation=https://github.com/prostopasta/linux-privacy-switch
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/privacy-tray
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
